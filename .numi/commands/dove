#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Open or probe the provenance-locked Deetjen measured dove, including its surface-native robot form.'
    exit 0
fi
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    printf '%s\n' 'usage: numi dove [open|probe|robot|robot-probe|runtime-probe] [MANIFEST]'
    printf '%s\n' '       numi dove policy [POLICYPACK] [MANIFEST]'
    printf '%s\n' '       numi dove runtime-benchmark [ENVIRONMENTS] [STEPS] [MANIFEST]'
    printf '%s\n' '       numi dove authority-sweep [CANDIDATES] [STEPS] [MANIFEST]'
    printf '%s\n' '       numi dove aero-audit [POLAR_SAMPLES] [MANIFEST]'
    printf '%s\n' '       numi dove trim-sweep [CANDIDATES] [GENERATIONS] [STEPS] [MANIFEST]'
    printf '%s\n' '       numi dove fatal-drop [HEIGHT] [DOWNWARD_SPEED] [STEPS] [MANIFEST]'
    printf '%s\n' 'The default manifest is ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json in this workspace.'
    printf '%s\n' 'Open: drag to orbit, scroll to zoom, Space to pause, R to replay.'
    printf '%s\n' 'Robot: one 4.8 s environment at wall-clock 1.0x using reflected nonperiodic source traversal; toolbar controls stop, run/pause, speed, pages, and 1/4/9-environment layouts.'
    printf '%s\n' 'Policy: run the retained best dove PolicyPack in one native Metal environment, presented at wall-clock 1.0x.'
    printf '%s\n' 'Runtime probe: execute the deformable surface as a transactional MetalWorld mechanics primitive.'
    printf '%s\n' 'Runtime benchmark: run the same proof at a bounded batch size (defaults: 64 environments, 32 steps).'
    printf '%s\n' 'Authority sweep: qualify signed lift plus bidirectional roll, pitch, and yaw loads (defaults: 2048 candidates, 36 steps).'
    printf '%s\n' 'Aero audit: run headless wind, scaling, symmetry, polar, dissipation, altitude-response, and cadence checks (default: 19 polar samples).'
    printf '%s\n' 'Trim sweep: optimize a static low-torque weight-supporting action through batched Metal physics (defaults: 512 candidates, 10 generations, 36 steps).'
    printf '%s\n' 'Fatal drop: compare flight-disabled impact with measured-surface trim from the identical release (defaults: 22 m, 0 m/s, 180 steps).'
    printf '%s\n' 'Blue is the measured-outline left wing; orange is the reflected right-wing assumption.'
    printf '%s\n' 'Open/replay remains nonperiodic measured motion; authority-sweep qualifies only the authored simulator envelope, not hardware flight.'
    exit 0
fi

dove_workspace=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
numi_root=${NUMI_LAB_ROOT:?Run this capability through the numi dispatcher.}
numi_build=${NUMI_BUILD_DIR:-"$numi_root/build"}
action=${1:-open}
if [ "$action" = "open" ] || [ "$action" = "probe" ] || [ "$action" = "robot" ] || [ "$action" = "robot-probe" ] || [ "$action" = "policy" ] || [ "$action" = "runtime-probe" ] || [ "$action" = "runtime-benchmark" ] || [ "$action" = "authority-sweep" ] || [ "$action" = "aero-audit" ] || [ "$action" = "trim-sweep" ] || [ "$action" = "fatal-drop" ]; then
    if [ "$#" -gt 0 ]; then shift; fi
else
    printf '%s\n' 'usage: numi dove [open|probe|robot|robot-probe|runtime-probe] [MANIFEST]' >&2
    exit 2
fi
if [ "$action" = "policy" ]; then
    policy_pack=${1:-"$dove_workspace/.numi/runs/dove-heading-forward-m4pro-v7/deployment.policypack"}
    manifest=${2:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 2 ]; then
        printf '%s\n' 'usage: numi dove policy [POLICYPACK] [MANIFEST]' >&2
        exit 2
    fi
elif [ "$action" = "runtime-benchmark" ]; then
    benchmark_environments=${1:-64}
    benchmark_steps=${2:-32}
    manifest=${3:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 3 ]; then
        printf '%s\n' 'usage: numi dove runtime-benchmark [ENVIRONMENTS] [STEPS] [MANIFEST]' >&2
        exit 2
    fi
elif [ "$action" = "authority-sweep" ]; then
    authority_candidates=${1:-2048}
    authority_steps=${2:-36}
    manifest=${3:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 3 ]; then
        printf '%s\n' 'usage: numi dove authority-sweep [CANDIDATES] [STEPS] [MANIFEST]' >&2
        exit 2
    fi
elif [ "$action" = "aero-audit" ]; then
    polar_samples=${1:-19}
    manifest=${2:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 2 ]; then
        printf '%s\n' 'usage: numi dove aero-audit [POLAR_SAMPLES] [MANIFEST]' >&2
        exit 2
    fi
elif [ "$action" = "trim-sweep" ]; then
    trim_candidates=${1:-512}
    trim_generations=${2:-10}
    trim_steps=${3:-36}
    manifest=${4:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 4 ]; then
        printf '%s\n' 'usage: numi dove trim-sweep [CANDIDATES] [GENERATIONS] [STEPS] [MANIFEST]' >&2
        exit 2
    fi
elif [ "$action" = "fatal-drop" ]; then
    drop_height=${1:-22}
    drop_speed=${2:-0}
    drop_steps=${3:-180}
    manifest=${4:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 4 ]; then
        printf '%s\n' 'usage: numi dove fatal-drop [HEIGHT] [DOWNWARD_SPEED] [STEPS] [MANIFEST]' >&2
        exit 2
    fi
else
    manifest=${1:-"$dove_workspace/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"}
    if [ "$#" -gt 1 ]; then
        printf '%s\n' 'usage: numi dove [open|probe|robot|robot-probe|runtime-probe] [MANIFEST]' >&2
        exit 2
    fi
fi

cmake -S "$numi_root" -B "$numi_build" -DCMAKE_BUILD_TYPE=Release >/dev/null
if [ "$action" = "runtime-probe" ] || [ "$action" = "runtime-benchmark" ] || [ "$action" = "authority-sweep" ] || [ "$action" = "aero-audit" ] || [ "$action" = "trim-sweep" ] || [ "$action" = "fatal-drop" ]; then
    target=metalrobo_measured_surface_robot_probe
elif [ "$action" = "robot" ] || [ "$action" = "robot-probe" ] || [ "$action" = "policy" ]; then
    target=metalrobo_measured_dove_robot_lab
else
    target=metalrobo_measured_dove_lab
fi
cmake --build "$numi_build" --target "$target" -j 4 >/dev/null
if [ "$action" = "policy" ]; then
    cmake --build "$numi_build" --target metalrobo_shaders -j 4 >/dev/null
    exec "$numi_build/bin/metalrobo_measured_dove_robot_lab" \
        --policy-pack "$policy_pack" \
        --metallib "$numi_build/shaders/MetalRobo.metallib" \
        "$manifest"
fi
if [ "$action" = "runtime-probe" ]; then
    exec "$numi_build/bin/metalrobo_measured_surface_robot_probe" "$manifest"
fi
if [ "$action" = "runtime-benchmark" ]; then
    exec "$numi_build/bin/metalrobo_measured_surface_robot_probe" \
        "$manifest" "$benchmark_environments" "$benchmark_steps"
fi
if [ "$action" = "authority-sweep" ]; then
    exec "$numi_build/bin/metalrobo_measured_surface_robot_probe" \
        --authority "$manifest" "$authority_candidates" "$authority_steps"
fi
if [ "$action" = "aero-audit" ]; then
    audit_dir="$dove_workspace/.numi/runs/dove-aero-audit"
    audit_report="$audit_dir/latest.txt"
    mkdir -p "$audit_dir"
    set +e
    "$numi_build/bin/metalrobo_measured_surface_robot_probe" \
        --aero-audit "$manifest" "$polar_samples" >"$audit_report" 2>&1
    audit_status=$?
    set -e
    cat "$audit_report"
    printf '%s\n' "  report: $audit_report"
    exit "$audit_status"
fi
if [ "$action" = "trim-sweep" ]; then
    exec "$numi_build/bin/metalrobo_measured_surface_robot_probe" \
        --trim "$manifest" "$trim_candidates" "$trim_generations" "$trim_steps"
fi
if [ "$action" = "fatal-drop" ]; then
    exec "$numi_build/bin/metalrobo_measured_surface_robot_probe" \
        --fatal-drop "$manifest" "$drop_height" "$drop_speed" "$drop_steps"
fi
if [ "$action" = "probe" ]; then
    exec "$numi_build/bin/metalrobo_measured_dove_lab" --probe "$manifest"
fi
if [ "$action" = "robot-probe" ]; then
    exec "$numi_build/bin/metalrobo_measured_dove_robot_lab" --probe "$manifest"
fi
if [ "$action" = "robot" ]; then
    exec "$numi_build/bin/metalrobo_measured_dove_robot_lab" "$manifest"
fi
exec "$numi_build/bin/metalrobo_measured_dove_lab" "$manifest"
